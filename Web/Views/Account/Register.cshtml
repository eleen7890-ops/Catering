@model Web.Models.RegisterForm
@{ ViewData["Title"] = "Create account"; }
<div class="page-heading"><p class="eyebrow">Your account</p><h1>Create an account</h1><p>Save your bookings and see your history.</p></div>
<form asp-action="Register" method="post" class="account-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <label asp-for="Email"></label><input asp-for="Email" type="email" /><span asp-validation-for="Email"></span>
    <label asp-for="Password"></label><input asp-for="Password" type="password" /><span asp-validation-for="Password"></span>
    <label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" type="password" /><span asp-validation-for="ConfirmPassword"></span>
    <button type="submit" class="btn btn-primary">Create account</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
