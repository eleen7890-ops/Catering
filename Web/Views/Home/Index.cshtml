@{ ViewData["Title"] = "Catering for your celebration"; }
<section class="hero">
    <div>
        <p class="eyebrow">Made for gathering</p>
        <h1>A menu that feels like your event.</h1>
        <p>Plan a wedding, birthday, company event, or private gathering. Share your tastes and budget, and we will suggest a complete menu.</p>
        <a class="btn btn-primary" asp-controller="Bookings" asp-action="Create">Plan an event</a>
    </div>
    <div class="hero-art" aria-hidden="true"><span>Gather<br />& celebrate</span></div>
</section>
<section class="features">
    <div><h2>Built around your taste</h2><p>Choose a cuisine, dietary preference, and the mood you want to create.</p></div>
    <div><h2>A clear budget</h2><p>Set a food budget per guest and see the total on your booking confirmation.</p></div>
    <div><h2>Birthday details</h2><p>Describe a cake or upload a photo so we can understand your idea.</p></div>
</section>
