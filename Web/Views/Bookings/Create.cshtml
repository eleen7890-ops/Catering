@model Web.Models.BookingForm
@using Domain
@{
    ViewData["Title"] = "Plan your event";
    var availableMenus = ViewData["AvailableMenus"] as IReadOnlyList<Application.Menus.CuratedMenuView>
        ?? Array.Empty<Application.Menus.CuratedMenuView>();
}

<div class="page-heading">
    <p class="eyebrow">Catering request</p>
    <h1>Plan your event</h1>
    <p>Choose one of our curated menus and tell us when and where to bring it.</p>
</div>

@if (availableMenus.Count == 0)
{
    <div class="menu-empty" role="status"><h2>@(ViewData["CatalogUnavailable"] is true ? "Menus are temporarily unavailable" : "No menus available yet")</h2><p>@(ViewData["CatalogUnavailable"] is true ? "We could not connect to the menu catalog. Please try again shortly." : "Our curated collection is coming soon. Please check back later.")</p><a asp-controller="Menus" asp-action="Index">Explore menus</a></div>
}
else
{

<form asp-action="Create" method="post" enctype="multipart/form-data" class="booking-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <fieldset>
        <legend>Your menu and event</legend>
        <div class="form-grid">
            <div><label asp-for="MenuId">Curated menu</label><select asp-for="MenuId"><option value="">Choose a menu</option>@foreach (var menu in availableMenus) { <option value="@menu.Id">@menu.Name — @menu.PriceJod.ToString("0.00") JOD, @menu.MinimumGuests–@menu.MaximumGuests guests</option> }</select><span asp-validation-for="MenuId"></span></div>
            <div><label asp-for="EventType">Event type</label><select asp-for="EventType" asp-items="Html.GetEnumSelectList<EventType>()"></select></div>
            <div><label asp-for="EventDate">Event date and time</label><input asp-for="EventDate" type="datetime-local" /><span asp-validation-for="EventDate"></span></div>
            <div><label asp-for="DietaryPreference">Diet</label><select asp-for="DietaryPreference" asp-items="Html.GetEnumSelectList<DietaryPreference>()"></select></div>
            <div><label asp-for="Taste"></label><select asp-for="Taste" asp-items="Html.GetEnumSelectList<TastePreference>()"></select></div>
            <div><label asp-for="GuestCount">Guests</label><input asp-for="GuestCount" type="number" min="1" /><span asp-validation-for="GuestCount"></span></div>
        </div>
    </fieldset>

    <fieldset id="cake-fields">
        <legend>Birthday cake inspiration</legend>
        <p>Optional: describe the cake or upload a reference photo.</p>
        <label asp-for="CakeDescription">Cake description</label>
        <textarea asp-for="CakeDescription" rows="4" maxlength="1000"></textarea>
        <span asp-validation-for="CakeDescription"></span>
        <label asp-for="CakeImage">Cake photo (JPEG, PNG, or WebP, up to 5 MB)</label>
        <input asp-for="CakeImage" type="file" accept="image/jpeg,image/png,image/webp" />
        <span asp-validation-for="CakeImage"></span>
    </fieldset>

    <fieldset>
        <legend>Contact and fulfillment</legend>
        <div class="form-grid">
            <div><label asp-for="CustomerName">Your name</label><input asp-for="CustomerName" /><span asp-validation-for="CustomerName"></span></div>
            <div><label asp-for="CustomerEmail">Email</label><input asp-for="CustomerEmail" type="email" /><span asp-validation-for="CustomerEmail"></span></div>
            <div><label asp-for="CustomerPhone">Phone</label><input asp-for="CustomerPhone" type="tel" /><span asp-validation-for="CustomerPhone"></span></div>
            <div><label asp-for="FulfillmentMethod">Fulfillment</label><select asp-for="FulfillmentMethod" asp-items="Html.GetEnumSelectList<FulfillmentMethod>()"></select></div>
        </div>
        <div id="delivery-fields"><label asp-for="DeliveryAddress">Delivery address</label><textarea asp-for="DeliveryAddress" rows="3"></textarea><span asp-validation-for="DeliveryAddress"></span></div>
    </fieldset>

    <input asp-for="TimezoneOffsetMinutes" type="hidden" />
    <button type="submit" class="btn btn-primary">Request booking</button>
</form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const eventType = document.getElementById('EventType');
        const fulfillment = document.getElementById('FulfillmentMethod');
        const updateFields = () => {
            const birthday = eventType.value === '@((int)EventType.Birthday)';
            const delivery = fulfillment.value === '@((int)FulfillmentMethod.Delivery)';
            document.getElementById('cake-fields').hidden = !birthday;
            document.getElementById('CakeDescription').disabled = !birthday;
            document.getElementById('CakeImage').disabled = !birthday;
            document.getElementById('delivery-fields').hidden = !delivery;
            document.getElementById('DeliveryAddress').disabled = !delivery;
        };
        if (eventType && fulfillment) {
            eventType.addEventListener('change', updateFields);
            fulfillment.addEventListener('change', updateFields);
            document.getElementById('TimezoneOffsetMinutes').value = new Date().getTimezoneOffset();
            updateFields();
        }
    </script>
}
