@model IReadOnlyList<Application.Bookings.BookingSummary>
@{
    ViewData["Title"] = "My bookings";
}
<div class="page-heading"><p class="eyebrow">Your account</p><h1>My bookings</h1></div>
@if (Model.Count == 0)
{
    <p>No bookings yet. <a asp-action="Create">Plan an event</a>.</p>
}
else
{
    @foreach (var booking in Model)
    {
        <section class="card-panel">
            <h2>@booking.EventType — @booking.EventDate.ToString("d")</h2>
            <p>@booking.Status · @booking.GuestCount guests · @booking.GrandTotal.ToString("N2") @booking.Currency</p>
            <ul class="menu-list">@foreach (var item in booking.MenuItems) { <li>@item.Category: @item.Name</li> }</ul>
        </section>
    }
}
