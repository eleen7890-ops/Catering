@model Web.Models.BookingConfirmation
@{
    ViewData["Title"] = "Booking requested";
}
<div class="page-heading">
    <p class="eyebrow">Request received</p>
    <h1>Thank you for booking</h1>
    <p>Your booking reference is <strong>@Model.Receipt.BookingId</strong>. We will contact you to confirm the details.</p>
</div>
<section class="card-panel">
    <h2>Your suggested menu</h2>
    <ul class="menu-list">
        <li><strong>Main:</strong> @Model.Menu.Main.Name</li>
        <li><strong>Side:</strong> @Model.Menu.Side.Name</li>
        <li><strong>Dessert:</strong> @Model.Menu.Dessert.Name</li>
    </ul>
    <p>Food: @Model.Receipt.FoodTotal.ToString("N2") @Model.Receipt.Currency</p>
    <p>Delivery: @Model.Receipt.DeliveryFee.ToString("N2") @Model.Receipt.Currency</p>
    <p>Discount: @Model.Receipt.DiscountAmount.ToString("N2") @Model.Receipt.Currency</p>
    <p class="total">Total: @Model.Receipt.GrandTotal.ToString("N2") @Model.Receipt.Currency</p>
</section>
