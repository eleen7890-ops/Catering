@{
    var homeUrl = Url.Action("Index", "Home") ?? "/";
    var isHome = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase);
    var pageTitle = ViewData["Title"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f4eb" />
    <meta name="description" content="Gather brings thoughtful catering to your favorite moments. Explore food for every mood and plan a gathering that feels like you." />
    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? "Gather" : $"{pageTitle} | Gather")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/menus.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="announcement-bar">The best moments happen around a table <span aria-hidden="true">✳</span> Made for gathering in Jordan</div>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg container-fluid site-nav" aria-label="Main navigation">
            <a class="navbar-brand gather-brand" asp-controller="Home" asp-action="Index" aria-label="Gather home"><span class="brand-flower" aria-hidden="true">✳</span>gather<span class="brand-dot">.</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNav" aria-controls="primaryNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="primaryNav">
                <ul class="navbar-nav mx-auto align-items-lg-center nav-links">
                    <li class="nav-item"><a class="nav-link" asp-controller="Menus" asp-action="Index">Explore Menu</a></li>
                    <li class="nav-item"><a class="nav-link" href="@(homeUrl)#packages">Packages</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Bookings" asp-action="Create">Plan Your Gathering</a></li>
                    @if (User.IsInRole("Admin")) { <li class="nav-item"><a class="nav-link" asp-controller="AdminMenus" asp-action="Index">Manage Menus</a></li> }
                </ul>
                <div class="nav-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="icon-link" asp-controller="Bookings" asp-action="History" aria-label="My bookings" title="My bookings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4.5 21c.7-4.1 3.2-6 7.5-6s6.8 1.9 7.5 6" /></svg></a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form"><button type="submit" class="text-link">Sign out</button></form>
                    }
                    else
                    {
                        <a class="icon-link" asp-controller="Account" asp-action="Login" aria-label="Sign in" title="Sign in"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4.5 21c.7-4.1 3.2-6 7.5-6s6.8 1.9 7.5 6" /></svg></a>
                    }
                    <button class="icon-link cart-trigger" type="button" data-bs-toggle="offcanvas" data-bs-target="#cartPanel" aria-controls="cartPanel" aria-label="Open cart" title="Open cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h2l2 11h11l2-8H6" /><circle cx="9" cy="20" r="1" /><circle cx="18" cy="20" r="1" /></svg><span class="cart-count" aria-label="0 items">0</span></button>
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" class="@(isHome ? "home-main" : "container inner-content")">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container-fluid footer-top">
            <div>
                <p class="footer-kicker">GOOD FOOD, GOOD COMPANY</p>
                <h2>Let’s make something<br /><em>lovely</em> happen.</h2>
                <a class="btn btn-cream" asp-controller="Bookings" asp-action="Create">Plan your gathering <span aria-hidden="true">↗</span></a>
            </div>
            <div class="footer-links">
                <p>Come on in</p>
                <a asp-controller="Menus" asp-action="Index">Explore menu</a>
                <a href="@(homeUrl)#packages">Our packages</a>
                <a asp-controller="Bookings" asp-action="Create">Plan a gathering</a>
                <a asp-controller="Account" asp-action="Login">Your account</a>
            </div>
        </div>
        <div class="container-fluid footer-bottom"><span class="footer-brand">gather<span>.</span></span><span>Made for moments worth sharing.</span><span>© @DateTime.UtcNow.Year Gather</span></div>
    </footer>

    <div class="offcanvas offcanvas-end cart-panel" tabindex="-1" id="cartPanel" aria-labelledby="cartPanelTitle">
        <div class="offcanvas-header"><h2 class="offcanvas-title" id="cartPanelTitle">Your cart</h2><button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close cart"></button></div>
        <div class="offcanvas-body cart-empty"><span class="cart-empty-icon" aria-hidden="true">✳</span><h3>Nothing on the table yet.</h3><p>Find a package you love or tell us about your gathering to get started.</p><a class="btn btn-olive" asp-controller="Bookings" asp-action="Create">Plan your gathering</a></div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
